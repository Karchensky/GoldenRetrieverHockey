node_modules/
# THE CAPTURE CORPUS IS TRACKED. It used to be ignored wholesale, which was
# defensible while this machine was the only place the site was built and
# indefensible the moment a build server had to produce it: CI cannot build what
# it cannot see, and a corpus on one disk is exactly the single point of failure
# this whole project exists to argue against.
#
# What is tracked: data/blobs (the retrieved bytes) and data/captures.jsonl (the
# log). Together they ARE the archive, and their history is meaningful — each
# refresh is a diff of what the league published.
#
# What is NOT tracked is below: manifest.sqlite. The store's own header says
# "DERIVED, NOT AUTHORITATIVE. Deleting this file loses nothing" — rebuildFromLog
# reconstructs it from captures.jsonl in about a second. Committing it would put
# a 2 MB binary with an opaque diff into every capture run for no gain.
/data/manifest.sqlite
/data/manifest.sqlite-shm
/data/manifest.sqlite-wal
*.log

# Local credentials — never committed
.secrets/
.env*.local

# Brainstorming visual-companion mockups (local only)
.superpowers/

# Agent harness settings. `settings.json` is the SHARED one and would apply to
# anyone who clones this — which, since the repository is public, is anyone.
# `settings.local.json` is the personal variant and is the right home for a
# permission mode chosen on one machine.
.claude/settings.local.json
.next/
apps/web/out/
# site.json is generated by build:data, and it is tracked anyway. A build server
# regenerates it, so tracking it is not what makes the site work — but it makes
# a clean checkout render without running the pipeline, and it turns every
# refresh into a reviewable diff of what actually changed on the site rather
# than an opaque "captures went up by 40".
.next-build
*.tsbuildinfo
.next-verify
.next-store/
.next-*/

# Agent scratch renders + local reference images (not repo source)
/tmp/
/*.jpg
/*.jpeg
/*.png
/*.webp
/*.avif

# TAX FORMS. DTF-17, ST-120 and anything like them carry the captain's SSN, his
# EIN, his date of birth and his Certificate of Authority number. They arrived
# in the repository root untracked on 2026-08-01 and would have been swept into
# the next `git add -A` — this repository is public.
/*.pdf

# aerial tournament render output (regenerable via scripts/aerial-shoot.mjs)
docs/aerial-tournament/shots/

# print-ready art is generated (npm run store:print)
dist/

# render output is regenerable (scripts/*-shoot.mjs); only the small frames/ copies are kept
docs/players-tournament/shots/

# opener lab render output (regenerable via scripts/lab-shoot.mjs); the small
# reference copies that are worth reviewing live in docs/opener/frames/
docs/opener/shots/

# fidelity harness output (regenerable via scripts/fidelity.mjs)
docs/fidelity/

# Blender re-export backups
*.glb.bak

# opener tournament render output (regenerable via scripts/openers-shoot.mjs)
docs/openers/shots/

# Python bytecode from the Blender scripts
__pycache__/
*.pyc
vector/.work/

# Agent render harnesses — temp, regenerable, never source
scratchpad/

# ---------------------------------------------------------------------------
# NOT PUBLISHED. Local working material and private source documents.
# ---------------------------------------------------------------------------

# The captain's own workbooks. TGR.xlsx carries 41 USA Hockey registration
# numbers and the stats workbook carries 32 more, an email address, per-player
# dues and the club's finances. build:data reads them, so a clean clone cannot
# regenerate site.json — site.json is tracked for exactly that reason, and the
# site builds and renders without them.
/TGR.xlsx
/Golden Retriever Hockey (1).xlsx

# Research evidence and working notes. Kept because a negative result is worth
# recording; unpublished because these transcribe a league official's personal
# mobile and email, and the roster emails carry registration numbers.
/docs/research/

# Review artefacts — a stale mobile screenshot sweep, an audio audition page,
# and the evidence for a dog animation that was measured and rejected.
/docs/mobile/
/docs/audio/
/assets/3d/rig-review/
/assets/3d/retriever-loop.*
/assets/3d/retriever-rebound.blend
/assets/3d/retriever-reconstruction-raw.glb
/docs/logos/vector/.work/

/.local-archive/

# Rendered from docs/logos/vector/master-svg/ by tools/build_vector_assets.py.
# 22 MB of derived PNGs that nothing in the build reads — matrix.ts prints from
# master-svg/ directly. Regenerate with the tool.
docs/logos/vector/high-dpi-png/
apps/web/public/store/.sources.json

# THIS REPOSITORY IS PUBLIC. Both of these are written for the captain and for
# whoever works on this next: costs, margins, supplier decisions, shop ids, the
# dashboard steps to open the store, what is left and whose it is. None of that
# belongs on GitHub, and a customer can read anything that does.
#
# README.md is the only document that ships. MANUAL.md is the one master file —
# the handbook was folded into it on 2026-08-01, because two documents about the
# same repository drift apart and the reader cannot tell which one is stale.
# TODO.md is the parking list.
/MANUAL.md
/TODO.md
/docs/HANDBOOK.md

# Superseded concept rounds, 62 MB of PNGs that nothing reads. The artwork in
# use is docs/logos/vector/master-svg/.
/output/

# Secrets for `wrangler dev` ONLY. `wrangler secret put` writes to the DEPLOYED
# Worker; local dev never reads those, it reads this file. Same keys, same
# names. Never committed.
.dev.vars
!.dev.vars.example

# wrangler build/dev scratch — regenerated every run
.wrangler/
